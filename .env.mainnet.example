# Securd -- XRPL EVM MAINNET deployment environment.
# Mirrors .env.deploy.example's variable set exactly (same names the CD workflow
# in .github/workflows/cd.yml already exports as GitHub environment vars/secrets
# for the "mainnet" environment) with mainnet-specific values filled in.
#
# Every REQUIRED_BEFORE_DEPLOY placeholder below is an operational value only you can
# supply (your multisig, your XRPL operating account, your guardian addresses) -- none
# of these are invented. Do not run any deploy script against mainnet until every
# REQUIRED_BEFORE_DEPLOY value has been replaced.

# XRPL EVM mainnet network access
XRPL_EVM_RPC_URL=https://rpc.xrplevm.org
XRPL_EVM_CHAIN_ID=1440000
DEPLOYER_PRIVATE_KEY=REQUIRED_BEFORE_DEPLOY
# Extra safety net checked live against the RPC at deploy time (see deploySecurdStack.ts) --
# independent of XRPL_EVM_CHAIN_ID above, which only configures hardhat's network object.
# Catches a stale/wrong .env in your shell before any gas is spent.
SECURD_EXPECTED_CHAIN_ID=1440000

# Final protocol owner / multisig -- becomes the cToken admin, Comptroller/Unitroller
# pending admin target, and owner of every ownable contract in the stack.
DEPLOY_OWNER=REQUIRED_BEFORE_DEPLOY
SECURD_PENDING_ADMIN=REQUIRED_BEFORE_DEPLOY

# Axelar contracts on XRPL EVM mainnet (chain 1440000).
# Source: axelarnetwork/axelar-contract-deployments, axelar-chains-config/info/mainnet.json,
# chains["xrpl-evm"].contracts -- fetched and cross-checked against the testnet entry in
# the same file on 2026-09-10 (Gateway/ITS are deterministic addresses shared across
# EVM chains in Axelar's deployment model; GasService correctly differs per chain).
AXELAR_GATEWAY=0xe432150cce91c13a887f7D836923d5597adD8E31
INTERCHAIN_TOKEN_SERVICE=0xB5FB4BE02232B1bBA4dC8f81dc24C26980dE9e3C
# Not consumed by XRPLSecurdBridgeAdapter's constructor, kept here for reference when
# registering new tokens directly against ITS outside the adapter.
# INTERCHAIN_TOKEN_FACTORY=0x83a93500d23Fbc3e82B410aD07A6a9F7A0670D66
# AXELAR_GAS_SERVICE=0x2d5d7d31F671F86C782533cc367F14109a082712

# Axelar chain id for XRPL Ledger mainnet -- this is the destinationChain the adapter
# uses when egressing BORROW/WITHDRAW proceeds back to XRPL Ledger. Confirmed against
# this repo's own docs (docs/xrpl-to-xrpl-evm-lending-guide.md, agent-axelar-xrpl-gmp-its-skills.md)
# and against axelar-contract-deployments mainnet.json chains["xrpl"].axelarId.
XRPL_DESTINATION_CHAIN=xrpl
# Native gas value (in wei) forwarded with each outbound ITS transfer. Size this against
# real mainnet XRPL EVM gas costs before go-live -- 0 will likely under-fund egress.
XRPL_EGRESS_GAS_VALUE=REQUIRED_BEFORE_DEPLOY

# Optional operator addresses
SECURD_PAUSE_GUARDIAN=REQUIRED_BEFORE_DEPLOY
SECURD_BORROW_CAP_GUARDIAN=REQUIRED_BEFORE_DEPLOY

# Oracle / IRM defaults used by deploySecurdStack.ts for the ONE shared JumpRateModelV2
# it deploys. Kept at 0 deliberately -- do not rely on this shared model for the real
# per-market curves. Apply the real per-market curves via
# scripts/applyMarketRiskParameters.ts (config/securd-market-risk-mainnet.json) as a
# signed-by-DEPLOY_OWNER post-deploy step. See docs/17-mainnet-launch-plan.md.
# Band Protocol StdReferenceProxy on XRPL EVM mainnet. Verified live on 2026-09-10: has
# deployed code and returns sane current prices for getReferenceData(XRP/USD),
# (USDC/USD), (ETH/USD), (WBTC/USD), (USDT/USD) -- see docs/17-mainnet-launch-plan.md.
BAND_STD_REFERENCE=0x6ec95bC946DcC7425925801F4e262092E0d1f83b
SECURD_CLOSE_FACTOR_MANTISSA=500000000000000000
# Global liquidation incentive = 10%. Comptroller only supports ONE global value
# (verified: closeFactorMantissa / liquidationIncentiveMantissa in ComptrollerStorage.sol
# are not per-market) -- the risk doc's per-asset values (5%-15%) cannot all be enforced
# simultaneously on-chain. 10% matches the majority of the Phase-1 market set (XRP, mXRP);
# see docs/17-mainnet-launch-plan.md for the full tradeoff writeup.
SECURD_LIQUIDATION_INCENTIVE_MANTISSA=1100000000000000000
SECURD_IRM_BASE_RATE_PER_YEAR=0
SECURD_IRM_MULTIPLIER_PER_YEAR=0
SECURD_IRM_JUMP_MULTIPLIER_PER_YEAR=0
SECURD_IRM_KINK=800000000000000000

# Deployment inputs
SECURD_MARKETS_FILE=config/securd-markets-mainnet-phase1.json
XRPL_TRUSTED_GMP_SOURCES_FILE=config/trusted-gmp-sources-mainnet.example.json
XRPL_TRUSTED_ITS_SOURCES_FILE=config/trusted-its-sources-mainnet.example.json
DEPLOYMENT_OUTPUT_FILE=deployments/xrpl-evm-mainnet.json

# Median oracle reporter (optional, for decentralized LP-token / fallback pricing).
# Recommended for the two LP markets in Phase 1 rather than a single trusted bot --
# decide before go-live per docs/15-xrpl-lp-oracle-bot.md.
SECURD_DEPLOY_MEDIAN_ORACLE_REPORTER=REQUIRED_BEFORE_DEPLOY
SECURD_MEDIAN_REPORTER_OWNER=REQUIRED_BEFORE_DEPLOY
SECURD_MEDIAN_REPORTER_CONFIG=REQUIRED_BEFORE_DEPLOY
SECURD_MEDIAN_REPORTER_REPORTERS=REQUIRED_BEFORE_DEPLOY
